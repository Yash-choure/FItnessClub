<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payment Successful | Fitness Club</title>
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    .payment-success-page { min-height: 78vh; display: grid; place-items: center; padding: 5rem 1rem; background: #f5faf7; }
    .payment-success-card { width: min(100%, 480px); padding: 3rem 2rem 2.25rem; text-align: center; background: #fff; border-radius: 18px; box-shadow: 0 18px 55px rgba(20, 70, 45, .12); }
    .success-icon { width: 92px; height: 92px; margin: 0 auto 1.5rem; border-radius: 50%; background: #1faa59; display: grid; place-items: center; animation: pop-in .45s cubic-bezier(.2,.9,.3,1.3) both; }
    .success-icon svg { width: 54px; height: 54px; fill: none; stroke: #fff; stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; }
    .success-icon path { stroke-dasharray: 70; stroke-dashoffset: 70; animation: draw-check .55s .35s ease-out forwards; }
    .payment-success-card h1 { margin: 0; color: #173b29; font-size: 2rem; }
    .payment-success-card .status { margin: .6rem 0 1.75rem; color: #1b8d4b; font-weight: 600; }
    .success-details { margin: 0 0 1.75rem; padding: 1rem; border-top: 1px solid #e4eee8; border-bottom: 1px solid #e4eee8; text-align: left; }
    .success-details div { display: flex; justify-content: space-between; gap: 1rem; padding: .45rem 0; color: #637267; }
    .success-details strong { color: #1d2b22; text-align: right; }
    .demo-note { font-size: .82rem; color: #8b6b18; background: #fff8df; border-radius: 8px; padding: .7rem; margin-bottom: 1.25rem; }
    .success-actions { display: flex; justify-content: center; gap: .7rem; flex-wrap: wrap; }
    .success-actions a { display: inline-block; padding: .75rem 1.1rem; border-radius: 6px; text-decoration: none; background: #1faa59; color: #fff; }
    .success-actions a.secondary { background: #edf3ef; color: #245537; }
    @keyframes pop-in { from { opacity: 0; transform: scale(.45); } to { opacity: 1; transform: scale(1); } }
    @keyframes draw-check { to { stroke-dashoffset: 0; } }
    @media (prefers-reduced-motion: reduce) { .success-icon, .success-icon path { animation: none; stroke-dashoffset: 0; } }
  </style>
</head>
<body>
  <%- include('partials/header', { activePage: 'pricing', authenticated: true }) %>
  <main class="payment-success-page">
    <section class="payment-success-card" aria-live="polite">
      <div class="success-icon" aria-label="Payment successful">
        <svg viewBox="0 0 52 52" role="img"><path d="M14 27l8 8 17-19"></path></svg>
      </div>
      <h1>Payment successful</h1>
      <p class="status">Your membership is now active</p>
      <div class="success-details">
        <div><span>Plan</span><strong><%= plan.name %></strong></div>
        <div><span>Amount</span><strong>Rs. <%= plan.price %></strong></div>
        <div><span>Transaction ID</span><strong><%= transactionId %></strong></div>
        <div><span>Date</span><strong><%= new Date().toLocaleDateString('en-IN') %></strong></div>
      </div>
      <div class="demo-note">Showcase demo only. No real payment was processed.</div>
      <div class="success-actions">
        <a href="/membershipdetails">View membership</a>
        <a class="secondary" href="/">Back to home</a>
      </div>
    </section>
  </main>
</body>
</html>