<%- include('partials/adminLayoutStart') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Daily attendance</h1>
  <form method="get" action="/attendance" class="d-flex gap-2">
    <input class="form-control" type="date" name="date" value="<%= date %>">
    <button class="btn btn-outline-primary" type="submit">View</button>
  </form>
</div>
<div class="table-responsive">
  <table class="table table-bordered align-middle">
    <thead><tr><th>Member</th><th>Phone</th><th>Status</th><th>Mark</th></tr></thead>
    <tbody>
      <% if (!members.length) { %><tr><td colspan="4" class="text-muted">No members found.</td></tr><% } %>
      <% members.forEach(member => { const current = byMember[String(member._id)]; %>
        <tr>
          <td><%= member.fullName %></td><td><%= member.phone %></td>
          <td><span class="badge <%= current === 'present' ? 'text-bg-success' : current === 'absent' ? 'text-bg-danger' : 'text-bg-secondary' %>"><%= current || 'Not marked' %></span></td>
          <td>
            <form method="post" action="/attendance" class="d-flex gap-2">
              <input type="hidden" name="memberId" value="<%= member._id %>">
              <input type="hidden" name="date" value="<%= date %>">
              <button class="btn btn-sm btn-success" name="status" value="present" type="submit">Present</button>
              <button class="btn btn-sm btn-outline-danger" name="status" value="absent" type="submit">Absent</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('partials/adminLayoutEnd') %>
