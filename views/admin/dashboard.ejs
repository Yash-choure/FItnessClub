<%- include('../partials/adminLayoutStart') %>
<h1 class="h3 mb-4">Admin Dashboard</h1>
<div class="row g-3 mb-4">
  <div class="col-md-3"><div class="card stat-card"><div class="card-body"><div class="text-muted">Signed-up users</div><div class="fs-3 fw-bold"><%= stats.totalUsers %></div></div></div></div>
  <div class="col-md-3"><div class="card stat-card"><div class="card-body"><div class="text-muted">Member profiles</div><div class="fs-3 fw-bold"><%= stats.totalMembers %></div></div></div></div>
  <div class="col-md-3"><div class="card stat-card"><div class="card-body"><div class="text-muted">Active / Expired</div><div class="fs-3 fw-bold text-success"><%= stats.activeMembers %></div><small class="text-muted"><%= stats.expiredMembers %> expired, <%= stats.frozenMembers %> frozen</small></div></div></div>
  <div class="col-md-3"><div class="card stat-card"><div class="card-body"><div class="text-muted">Plans / Trainers / Payments</div><div class="fs-5 fw-bold"><%= stats.planCount %> / <%= stats.trainerCount %> / <%= stats.paymentCount %></div></div></div></div>
</div>

<div class="card mb-4">
  <div class="card-header">Monthly revenue</div>
  <div class="card-body">
    <canvas id="revenueChart" height="90"></canvas>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-header d-flex justify-content-between"><span>Recent signups</span><a href="/admin/users">View all</a></div>
      <div class="card-body p-0">
        <table class="table mb-0">
          <thead><tr><th>Username</th><th>Email</th><th>Joined</th></tr></thead>
          <tbody>
            <% if (!recentUsers.length) { %>
              <tr><td colspan="3" class="text-muted">No website signups yet.</td></tr>
            <% } %>
            <% recentUsers.forEach(u => { %>
              <tr>
                <td><%= u.username %></td>
                <td><%= u.email %></td>
                <td><%= u.createdAt ? new Date(u.createdAt).toLocaleString('en-IN') : '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="card">
      <div class="card-header">Selected memberships</div>
      <div class="card-body p-0">
        <table class="table mb-0">
          <thead><tr><th>Member</th><th>Plan</th><th>Status</th></tr></thead>
          <tbody>
            <% if (!recentMemberships.length) { %>
              <tr><td colspan="3" class="text-muted">No membership selections yet.</td></tr>
            <% } %>
            <% recentMemberships.forEach(m => { %>
              <tr>
                <td><%= m.user ? m.user.username : m.name %></td>
                <td><%= m.membershipType %></td>
                <td><%= m.status %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-header">Expiry alerts (≤ 7 days)</div>
      <div class="card-body p-0">
        <table class="table mb-0">
          <thead><tr><th>Member</th><th>Plan</th><th>Valid till</th></tr></thead>
          <tbody>
            <% if (!expiringSoon.length) { %>
              <tr><td colspan="3" class="text-muted">No upcoming expiries.</td></tr>
            <% } %>
            <% expiringSoon.forEach(m => { %>
              <tr>
                <td><a href="/admin/members/<%= m._id %>"><%= m.fullName %></a></td>
                <td><%= m.planId ? m.planId.name : '-' %></td>
                <td><%= new Date(m.validTill).toLocaleDateString('en-IN') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="card">
      <div class="card-header">Recent payments</div>
      <div class="card-body p-0">
        <table class="table mb-0">
          <thead><tr><th>Receipt</th><th>Member</th><th>Amount</th></tr></thead>
          <tbody>
            <% if (!recentPayments.length) { %>
              <tr><td colspan="3" class="text-muted">No payments yet.</td></tr>
            <% } %>
            <% recentPayments.forEach(p => { %>
              <tr>
                <td><a href="/payments/<%= p._id %>/receipt"><%= p.receiptNo %></a></td>
                <td><%= p.memberId ? p.memberId.fullName : '-' %></td>
                <td>Rs. <%= Number(p.amount).toFixed(2) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
  const revenue = <%- JSON.stringify((typeof revenueChart !== 'undefined' ? revenueChart : []).map(r => ({
    label: (r._id.month + '/' + r._id.year),
    total: r.total
  }))) %>;
  const ctx = document.getElementById('revenueChart');
  if (ctx) {
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: revenue.map(r => r.label),
        datasets: [{ label: 'Revenue (Rs.)', data: revenue.map(r => r.total), backgroundColor: '#dc3545' }]
      },
      options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
    });
  }
</script>
<%- include('../partials/adminLayoutEnd') %>
