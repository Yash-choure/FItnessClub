<!-- CONTACT START  -->
<section class="contact-section">
    <div class="contact-container">
        <div class="contact-left" data-aos="fade-right">
            <h2 data-aos="fade-up" data-aos-delay="100">CONTACT</h2>
            <h4 data-aos="fade-up" data-aos-delay="180">Get In Touch Today!</h4>
            <h3 data-aos="fade-up" data-aos-delay="260">9923937637</h3>
            <div class="more-info">
                <p data-aos="fade-up" data-aos-delay="340">Nagpur, Maharashtra</p>
                <p data-aos="fade-up" data-aos-delay="420">Fitnessclubnagpur@befit.com</p>
            </div>
        </div>
        <div class="contact-form" data-aos="fade-left">
            <form action="/contact" method="post">
                <input type="text" name="name" id="name" placeholder="Your name*" required data-aos="fade-up" data-aos-delay="180">
                <input type="email" name="email" placeholder="Your email*" required data-aos="fade-up" data-aos-delay="260">
                <input type="text" name="subject" id="subject" placeholder="Subject*" required data-aos="fade-up" data-aos-delay="340">
                <input type="hidden" name="preferredCommunication" id="preferredCommunication" value="email">
                <textarea name="message" id="message" placeholder="Your message*" cols="20" rows="10" data-aos="fade-up" data-aos-delay="420"></textarea>
                <button type="submit" data-aos="fade-up" data-aos-delay="500">SEND <i class="fa-solid fa-paper-plane"></i></button>
            </form>
        </div>
    </div>
</section>
<!-- CONTACT END  -->