<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | OGMMS</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/trainers/dashboard">OGMMS Trainer</a>
    <div class="navbar-nav ms-auto">
      <a class="nav-link" href="/">Public site</a>
      <a class="nav-link text-warning" href="/auth/logout">Logout</a>
    </div>
  </div>
</nav>
<main class="container py-4">
  <h1 class="h3 mb-3">Assigned member roster</h1>
  <% if (!trainer) { %>
    <div class="alert alert-warning">No trainer profile is linked to this login.</div>
  <% } else { %>
    <p class="text-muted"><%= trainer.fullName %> · <%= trainer.speciality %> · <%= trainer.shift %> shift · <%= members.length %> members</p>
    <table class="table table-striped">
      <thead><tr><th>Member</th><th>Plan</th><th>Status</th><th>Valid till</th><th>Phone</th></tr></thead>
      <tbody>
        <% if (!members.length) { %>
          <tr><td colspan="5" class="text-muted">No members assigned yet.</td></tr>
        <% } %>
        <% members.forEach(m => { %>
          <tr>
            <td><%= m.fullName %></td>
            <td><%= m.planId ? m.planId.name : '-' %></td>
            <td><%= m.status %></td>
            <td><%= m.validTill ? new Date(m.validTill).toLocaleDateString('en-IN') : '-' %></td>
            <td><%= m.phone %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</main>
</body>
</html>
