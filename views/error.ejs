<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Error' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-5">
    <div class="alert alert-danger">
      <h1 class="h4"><%= typeof title !== 'undefined' ? title : 'Error' %></h1>
      <p class="mb-0"><%= typeof message !== 'undefined' ? message : 'Something went wrong.' %></p>
    </div>
    <a href="/" class="btn btn-secondary">Home</a>
    <a href="/auth/login" class="btn btn-warning">Admin login</a>
  </div>
</body>
</html>
