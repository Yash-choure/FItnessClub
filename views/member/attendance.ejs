<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> | OGMMS</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/admin.css"></head>
<body><nav class="navbar navbar-dark bg-dark"><div class="container"><a class="navbar-brand" href="/members/dashboard">OGMMS Member</a><a class="nav-link text-white" href="/auth/logout">Logout</a></div></nav>
<main class="container py-4"><h1 class="h3 mb-4">My attendance</h1><% if (!member) { %><div class="alert alert-warning">No member profile is linked to this login.</div><% } else { %><div class="table-responsive"><table class="table table-bordered"><thead><tr><th>Date</th><th>Status</th></tr></thead><tbody><% if (!records.length) { %><tr><td colspan="2" class="text-muted">No attendance records yet.</td></tr><% } %><% records.forEach(record => { %><tr><td><%= new Date(record.date).toLocaleDateString('en-IN') %></td><td><span class="badge <%= record.status === 'present' ? 'text-bg-success' : 'text-bg-danger' %>"><%= record.status %></span></td></tr><% }) %></tbody></table></div><% } %></main></body></html>
